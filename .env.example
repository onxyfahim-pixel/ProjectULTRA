# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT Secret for Express API auth & RBAC
JWT_SECRET="garments-erp-jwt-secret-key-change-in-production"
PORT=3000

# MySQL Database Connection String on Host PC
# Format: mysql://[user]:[password]@localhost:3306/garments_erp
DATABASE_URL="mysql://root:password@localhost:3306/garments_erp"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_DATABASE="garments_erp"
